# Multi-stage production Dockerfile for AegisRAG React frontend
# Stage 1: Build static distribution
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first for better Docker layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy application source files
COPY frontend/ ./

# Compile TypeScript and bundle Vite application
RUN npm run build

# Stage 2: Serve via hardened Nginx reverse proxy
FROM nginx:1.27-alpine AS runner

# Remove default static pages
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled SPA bundle from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with API reverse proxy and security headers
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
