# ==========================================
# AegisRAG - Enterprise RAG Environment Configuration
# ==========================================
# NOTE: Copy this file to .env for local development.
# DO NOT commit real secrets or credentials to version control.

# Application Core
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AegisRAG Enterprise Assistant"
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication (JWT)
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegisrag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegisrag

# Storage Configuration (local or s3)
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=backend/data/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf","docx","xlsx"]

# Vector Database (ChromaDB)
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=backend/data/chroma
CHROMA_COLLECTION_NAME=aegis_rag_chunks

# Embedding Model Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Provider Configuration (groq or openai-compatible)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_placeholder
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Optional: OpenAI-compatible endpoint
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_API_BASE=https://api.openai.com/v1

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
